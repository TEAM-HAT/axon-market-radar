<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_white"
    android:clipToOutline="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_blue_top"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/mark" />
            <TextView
                android:id="@+id/eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="Market Radar · Week 41 · 3–9 Oct"
                android:textAllCaps="true"
                android:textColor="@color/on_blue_2"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="bottom"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed-light"
                android:includeFontPadding="false"
                android:text="6"
                android:textColor="@color/white"
                android:textSize="54sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="5dp"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/count_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:text="Moves this week"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="17sp" />
                <TextView
                    android:id="@+id/mix"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif-condensed"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="4 regulatory actions · 1 partnership · 1 licence"
                    android:textAllCaps="true"
                    android:textColor="@color/on_blue_2"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.08"
            android:maxLines="3"
            android:text="Dubai gave Rain a full exchange licence. Europe set a three-month deadline for unauthorised stablecoins."
            android:textColor="@color/on_blue_2"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="2dp">
            <LinearLayout
                android:id="@+id/row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/glyph1"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="7dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/g_dia" />
                    <TextView
                        android:id="@+id/meta1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.1"
                        android:maxLines="1"
                        android:text="Regulation · ESMA · 8 Oct"
                        android:textAllCaps="true"
                        android:textColor="@color/ink_3"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/title1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:maxLines="2"
                    android:text="ESMA sets three-month wind-down for unauthorised stablecoin services"
                    android:textColor="@color/ink"
                    android:textSize="14.5sp" />
            </LinearLayout>
            <FrameLayout
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />
            <LinearLayout
                android:id="@+id/row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:id="@+id/glyph2"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="7dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/g_dot" />
                    <TextView
                        android:id="@+id/meta2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-condensed"
                        android:letterSpacing="0.1"
                        android:maxLines="1"
                        android:text="Partnership · 8 Oct"
                        android:textAllCaps="true"
                        android:textColor="@color/ink_3"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/title2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:maxLines="2"
                    android:text="Visa and Abu Dhabi's ADI Foundation agree to explore on-chain payments"
                    android:textColor="@color/ink"
                    android:textSize="14.5sp" />
            </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:paddingTop="4dp">
        <TextView
            android:id="@+id/updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:text="Updated Fri 9 Oct"
            android:textAllCaps="true"
            android:textColor="@color/ink_3"
            android:textSize="9.5sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.1"
            android:text="Open the radar →"
            android:textAllCaps="true"
            android:textColor="@color/blue"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
