<resources>
    <style name="Radar" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <!-- The carousel widget's card stack: Android outlines a dragged or tapped card in the theme's primary
         colour; a clear primary keeps the cards flat, as in the app. -->
    <style name="RadarStack">
        <item name="android:colorPrimary">@android:color/transparent</item>
    </style>
</resources>
